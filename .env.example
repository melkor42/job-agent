# ---------------------------------------------------------------------------
# 1. Inference — three free providers, one chain per role
# ---------------------------------------------------------------------------
#   https://openrouter.ai -> Keys -> Create Key
#   https://console.groq.com -> API Keys
#   https://build.nvidia.com -> any model -> Get API Key
#
# All three speak OpenAI chat completions, so one `@ai-sdk/openai` client per
# endpoint covers them and every model is addressed `provider:id`
# (`groq:openai/gpt-oss-120b`). A bare id means openrouter, which keeps the ids
# from before the chain existed valid. A provider whose key is missing simply
# drops out of every chain, so paste what you have and the rest degrades.
#
# Free tiers, measured here rather than copied from a pricing page:
#   OpenRouter  ~20 req/min, 50 req/day on $0 credit; `:free` ids only
#   Groq        8000 tokens/min on gpt-oss-120b — answers in <2s, but a 42k-char
#               prompt asks 18k and is refused with a 413
#   NVIDIA NIM  reads those same 42k chars in 15–23s, and retires models with a 410
GROQ_API_KEY=
NVIDIA_API_KEY=
OPENROUTER_API_KEY=

# Which free model does what. A comma-separated list is a fallback chain: the
# app asks the first, and moves to the next only when that one fails — every
# retry hits a different provider, because `maxRetries: 0` and the SDK's own
# retries would re-enter the same exhausted pool.
#
# This is not decoration. `:free` models share one pool per provider, so any
# single id answers 429 or 502 for minutes at a time, and each provider runs
# out on its own clock.
#
# Defaults are compiled into lib/providers.ts, per role and provider, in the
# order to try them. You only need these variables to override — setting one
# replaces that role's whole chain with the list given:
#   SEARCH_MODEL=groq:openai/gpt-oss-120b,nim:nvidia/nemotron-3-super-120b-a12b
#   SUMMARY_MODEL=nim:nvidia/nemotron-3-ultra-550b-a55b
#
# Only take OpenRouter ids whose top-level `supported_parameters` contain
# "tools", because both agents get their structured answer through tool calling.
# (Nested `parameters.supported_parameters` is empty on every model — read the
# top-level field.) The UI's INFERENCE dropdown reorders the chain; it never
# narrows it, so choosing a provider still keeps the fallbacks behind it.
#
# The judge has no Groq entry on purpose: Groq's only judge-grade model is the
# one the planner runs on, and a judge that grades its own answers proves
# nothing. One model only — a judge that fails over mid-suite changes which
# standard your scores were graded against.
JUDGE_MODEL=nim:nvidia/nemotron-3-ultra-550b-a55b

# ---------------------------------------------------------------------------
# 2. Search + scrape — Firecrawl (free key, no card)
# ---------------------------------------------------------------------------
#   1. https://firecrawl.dev -> sign up
#   2. Dashboard -> API Keys -> copy
#
# One call searches Google scoped to the ATS hosts below and returns every
# result's page already cleaned to markdown.
#
# Free tier: 500 credits and 10 REQUESTS PER MINUTE. A query with scraping is
# ~10 credits (so ~50 queries/month) and one request (so ~10 queries/minute).
FIRECRAWL_API_KEY=

# Which boards to search, comma separated. Defaults to the DACH list in
# lib/search.ts: personio, greenhouse, lever, workday, smartrecruiters,
# stepstone. Point it somewhere narrower to see a single ATS's inventory.
# SEARCH_DOMAINS=jobs.personio.de,stepstone.de

# 3. Tracing — LangSmith
# ---------------------------------------------------------------------------
# Everything is already wired. Filling these in is the only step.
#
#   1. Sign up at https://eu.smith.langchain.com
#   2. Settings > API Keys > Create API Key
#   3. Set LANGSMITH_TRACING=true and paste the key
#
# LANGSMITH_ENDPOINT is required — without it the client has nowhere to send.
# EU accounts must use the eu. endpoint or the traces are silently dropped.
# Scripts call flushTracing() because traces are batched and a short-lived
# process exits before the batch goes out — which looks exactly like tracing
# being broken.
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=pr-earnest-worth-13
